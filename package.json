{
  "name": "@fieldrobin/sdk",
  "version": "0.2.0",
  "description": "Typed JavaScript/TypeScript client for FieldRobin public APIs and authenticated MCP tools — fetch-based, zero deps",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praisondani/fieldrobin-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/praisondani/fieldrobin-sdk/issues"
  },
  "homepage": "https://fieldrobin.com/sdk",
  "files": [
    "index.mjs",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "test": "node --test test/sdk.test.mjs",
    "prepublishOnly": "npm test"
  }
}
